{
  "entity": {
    "sensor": {
      "incoming": {
        "default": "mdi:package-down"
      },
      "outgoing": {
        "default": "mdi:package-up"
      },
      "ready_for_pickup": {
        "default": "mdi:store-clock"
      },
      "location": {
        "default": "mdi:map-marker"
      },
      "shipment": {
        "default": "mdi:package-variant-closed",
        "state": {
          "aviso": "mdi:email-fast-outline",
          "delivery_hand_over": "mdi:human-dolly",
          "in_distribution": "mdi:warehouse",
          "in_delivery": "mdi:truck-delivery",
          "delivered": "mdi:package-variant-closed-check",
          "unknown": "mdi:help-box"
        }
      }
    },
    "select": {
      "delivery_option": {
        "default": "mdi:home-import-outline",
        "state": {
          "front_door": "mdi:door",
          "apartment_door": "mdi:door-closed",
          "mailbox": "mdi:mailbox",
          "garage": "mdi:garage",
          "drop_off_place": "mdi:map-marker",
          "neighbor": "mdi:account-arrow-right",
          "post_office": "mdi:store",
          "parcel_locker": "mdi:locker-multiple"
        }
      },
      "pickup_location": {
        "default": "mdi:storefront-outline"
      }
    }
  },
  "services": {
    "redirect_shipment": {
      "service": "mdi:directions-fork"
    },
    "reset_redirection": {
      "service": "mdi:undo-variant"
    },
    "get_redirection_options": {
      "service": "mdi:format-list-bulleted"
    },
    "add_shipment": {
      "service": "mdi:package-variant-plus"
    },
    "remove_shipment": {
      "service": "mdi:package-variant-minus"
    },
    "rename_shipment": {
      "service": "mdi:rename-box"
    },
    "track_shipment": {
      "service": "mdi:map-marker-path"
    }
  }
}
